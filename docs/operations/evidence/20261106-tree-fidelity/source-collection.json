  "collected_at_utc": "2026-11-06T11:46:12.069382+00:00",
  "sections": [
    {
      "code": "I",
      "title": "Живые животные; продукты животного происхождения"
    },
    {
      "code": "II",
      "title": "Продукты растительного происхождения"
    },
    {
      "code": "III",
      "title": "Жиры и масла животного, растительного или микробиологического происхождения и продукты их расщепления; готовые пищевые жиры; воски животного или растительного происхождения"
    },
    {
      "code": "IV",
      "title": "Готовые пищевые продукты; алкогольные и безалкогольные напитки и уксус; табак и промышленные заменители табака; продукция, содержащая или не содержащая никотин, предназначенная для вдыхания без горения; прочая продукция, содержащая никотин и предназначенная для поступления никотина в организм человека"
    },
    {
      "code": "V",
      "title": "Минеральные продукты"
    },
    {
      "code": "VI",
      "title": "Продукция химической и связанных с ней отраслей промышленности"
    },
    {
      "code": "VII",
      "title": "Пластмассы и изделия из них; каучук, резина и изделия из них"
    },
    {
      "code": "VIII",
      "title": "Необработанные шкуры, выделанная кожа, натуральный мех и изделия из них; шорно-седельные изделия и упряжь; дорожные принадлежности, сумки и аналогичные им товары; изделия из внутренних органов животных (кроме шелкоотделительных желез шелкопряда)"
    },
    {
      "code": "IX",
      "title": "Древесина и изделия из нее; древесный уголь; пробка и изделия из нее; изделия из соломы, альфы или из прочих материалов для плетения; корзиночные и другие плетеные изделия"
    },
    {
      "code": "X",
      "title": "Масса из древесины или из других волокнистых целлюлозных материалов; регенерируемые бумага или картон (макулатура и отходы); бумага, картон и изделия из них"
    },
    {
      "code": "XI",
      "title": "Текстильные материалы и текстильные изделия"
    },
    {
      "code": "XII",
      "title": "Обувь, головные уборы, зонты, солнцезащитные зонты, трости, трости-сиденья, хлысты, кнуты и их части; обработанные перья и изделия из них; искусственные цветы; изделия из человеческого волоса"
    },
    {
      "code": "XIII",
      "title": "Изделия из камня, гипса, цемента, асбеста, слюды или аналогичных материалов; керамические изделия; стекло и изделия из него"
    },
    {
      "code": "XIV",
      "title": "Жемчуг природный или культивированный, драгоценные или полудрагоценные камни, драгоценные металлы, металлы, плакированные драгоценными металлами, и изделия из них; бижутерия; монеты"
    },
    {
      "code": "XV",
      "title": "Недрагоценные металлы и изделия из них"
    },
    {
      "code": "XVI",
      "title": "Машины, оборудование и механизмы; электротехническое оборудование; их части; звукозаписывающая и звуковоспроизводящая аппаратура, аппаратура для записи и воспроизведения телевизионного изображения и звука, их части и принадлежности"
    },
    {
      "code": "XVII",
      "title": "Средства наземного транспорта, летательные аппараты, плавучие средства и относящиеся к транспорту устройства и оборудование"
    },
    {
      "code": "XVIII",
      "title": "Инструменты и аппараты оптические, фотографические, кинематографические, измерительные, контрольные, прецизионные, медицинские или хирургические; часы всех видов; музыкальные инструменты; их части и принадлежности"
    },
    {
      "code": "XIX",
      "title": "Оружие и боеприпасы; их части и принадлежности"
    },
    {
      "code": "XX",
      "title": "Разные промышленные товары"
    },
    {
      "code": "XXI",
      "title": "Произведения искусства, предметы коллекционирования и антиквариат"
    }
  ],
