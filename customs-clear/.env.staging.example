# Copy this file to .env.staging. Empty required values intentionally make
# `docker compose` fail before startup. Never commit the filled file.

# Absolute path to a standalone SQLite snapshot produced by
# staging/prepare_database.py.
STAGING_DATABASE_PATH=

# Generate independent values for local staging; do not reuse production data.
STAGING_SECRET_KEY=
STAGING_ADMIN_PASSWORD=
STAGING_VIEWER_PASSWORD=
STAGING_DECLARANT_PASSWORD=
STAGING_ADMIN_API_TOKEN=

# Compose hardcodes loopback binding; remote exposure is intentionally unsupported.
STAGING_BACKEND_PORT=8001
STAGING_FRONTEND_PORT=3000

# Advisory is visible; every official/NTM enforcement bridge remains forced off
# in docker-compose.staging.yml.
STAGING_NTM_FULL_ADVISORY_ENABLED=1
