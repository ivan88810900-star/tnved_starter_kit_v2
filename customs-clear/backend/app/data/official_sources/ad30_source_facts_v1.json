    {
      "fact_id": "d4.collection_procedure",
      "value_json": "\"Addresses the member states' customs authorities. From entry into force of this decision through 12 November 2026 inclusive, it refers to collection at rates established by Decision 12 of 9 February 2021 under the procedure for collecting provisional anti-dumping duties.\"",
      "evidence_path": "docs/ai-workflow/evidence/eec-ad30-decision4-notice-review-20260912.json",
      "evidence_file_sha256": "642415be4c272ac6d54f9a73781ef61a1996d52c4d325483610d7620ca2bd721",
      "json_pointer": "/documents/0/observations/2/observation",
      "body_sha256": "44a277edf5f9bf76a0ccd79d6e41f9820548fcbaa1b638d1cd44469a79344aef",
