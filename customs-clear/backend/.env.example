# Шаблон переменных: скопируйте ../.env.example → сюда как файл `.env`
# или объедините оба файла в один .env в этом каталоге (откуда запускается uvicorn).

# LLM: основной провайдер — Anthropic Claude Haiku (работает из РФ без proxyapi)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

# Fallback: Google Gemini (через AI Studio или GEMINI_BASE_URL proxy)
GEMINI_API_KEY=

# Experimental semantic TN VED search. Both operations are explicit and default OFF.
# The current legacy index uses tnved_entries and must not replace the verified
# product catalogue search over tnved_commodities.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TNVED_SEMANTIC_SEARCH_ENABLED=0
TNVED_SEMANTIC_INGEST_ENABLED=0

# Official NTM: advisory visibility is default ON; curated broker bridge is
# implemented for shadow audit only and must remain OFF until a rollout decision.
NTM_V2_OFFICIAL_FULL_ADVISORY_ENABLED=1
NTM_V2_OFFICIAL_CURATED_ENFORCEMENT_ENABLED=0

# Автообновление структурированных официальных реестров. Ежедневно: ЦБ, СГР,
# нотификации ФСБ, РЭС/ВЧУ, OFAC, ЕС. Еженедельно: ФСА, ТРОИС, справочники ФТС.
# Нормативные PDF только мониторятся в scheduled GitHub workflow и никогда не
# включают enforcement автоматически.
REGULATORY_SYNC_SCHEDULER_ENABLED=true
REGULATORY_SYNC_TZ=Europe/Moscow
REGULATORY_SOURCE_UPDATE_TIMEOUT_SECONDS=1800

# API-прокси Gemini (опционально): только домен, без https://
# GEMINI_BASE_URL=api.proxyapi.ru

# Proxy для Google Gemini (раскомментируйте при необходимости):
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
